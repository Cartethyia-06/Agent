# Sao chép file này thành .env rồi điền giá trị. File .env đã nằm trong .gitignore.

# Lấy key ở https://aistudio.google.com/apikey (key thuộc Gemini API, không thuộc gói Google AI Pro)
GEMINI_API_KEY=

# Model dùng để tìm web, thử lần lượt từ trái sang phải khi model trước hết hạn mức.
# Các alias *-latest tự trỏ sang bản mới nhất. Xem model có sẵn: uv run python -m tools.doctor --probe
GEMINI_SEARCH_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Model tạo ảnh (Nano Banana 2, rồi Nano Banana 2 Lite)
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# Giới hạn tự đặt mỗi ngày, để vòng lặp lỗi không tiêu hết credit. 0 = không giới hạn.
GEMINI_SEARCH_DAILY_LIMIT=50
GEMINI_IMAGE_DAILY_LIMIT=5

# Thời gian chờ tối đa cho mỗi lệnh gọi (giây)
GEMINI_TIMEOUT_SECONDS=120
CODEX_TIMEOUT_SECONDS=600
AGY_TIMEOUT_SECONDS=300

# Tùy chọn: model cho Codex (để trống = Codex tự chọn theo gói ChatGPT)
CODEX_MODEL=

# Tùy chọn: Antigravity CLI. Để trống AGY_PATH nếu lệnh `agy` đã có trong PATH.
AGY_PATH=
AGY_MODEL=
AGY_EXTRA_ARGS=
