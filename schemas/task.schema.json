{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task (việc Claude giao đi)",
  "description": "PLAN.md mục 6. Nhạc trưởng giao việc theo mẫu này.",
  "type": "object",
  "required": ["task_id", "agent", "goal", "expected_output"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "string",
      "enum": [
        "gemini_search",
        "agy_search",
        "web_search",
        "gemini_image",
        "image_handoff",
        "codex_opinion",
        "codex_review",
        "coder",
        "analyst",
        "researcher"
      ]
    },
    "goal": { "type": "string", "minLength": 1 },
    "expected_output": { "type": "string" },
    "depends_on": { "type": "array", "items": { "type": "string" } }
  }
}
